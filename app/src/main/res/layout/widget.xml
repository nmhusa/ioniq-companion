<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="18dp" android:background="@drawable/card">
 <TextView android:id="@+id/vehicle_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="IONIQ Companion" android:textColor="#8DE3CF" android:textSize="14sp"/>
 <TextView android:id="@+id/battery" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—%" android:textColor="#FFFFFF" android:textSize="32sp"/>
 <TextView android:id="@+id/detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open app to connect" android:textColor="#D2DFE5" android:textSize="13sp"/>
 <TextView android:id="@+id/time" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No vehicle data" android:textColor="#A5B9C5" android:textSize="11sp"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
  <Button android:id="@+id/refresh" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Refresh" android:textSize="11sp"/>
  <Button android:id="@+id/lock" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Lock" android:textSize="11sp"/>
  <Button android:id="@+id/climate" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Climate" android:textSize="11sp"/>
 </LinearLayout>
</LinearLayout>
